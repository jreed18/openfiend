{
  "name": "openfiend",
  "version": "0.1.0",
  "description": "Open-source AI agent platform with security you can actually see",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm build:frontend && pnpm --filter @openfiend/backend dev",
    "dev:frontend": "pnpm --filter @openfiend/frontend dev",
    "build": "pnpm --filter @openfiend/shared build && pnpm --filter @openfiend/frontend build && pnpm --filter @openfiend/backend build",
    "build:frontend": "pnpm --filter @openfiend/shared build && pnpm --filter @openfiend/frontend build",
    "start": "node packages/backend/dist/index.js",
    "start:prod": "pnpm build && node packages/backend/dist/index.js",
    "type-check": "pnpm -r run type-check",
    "lint": "pnpm -r run lint",
    "daemon:start": "pm2 start ecosystem.config.js",
    "daemon:stop": "pm2 stop all",
    "daemon:restart": "pm2 restart all",
    "daemon:logs": "pm2 logs",
    "daemon:status": "pm2 status"
  },
  "devDependencies": {
    "better-sqlite3": "^12.8.0",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "pm2": "^6.0.14"
  },
  "dependencies": {
    "@types/uuid": "^11.0.0",
    "uuid": "^13.0.0"
  }
}
